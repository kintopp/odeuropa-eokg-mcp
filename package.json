{
  "name": "odeuropa-eokg-mcp",
  "version": "0.5.0",
  "private": true,
  "description": "MCP server for the European Olfactory Knowledge Graph (Odeuropa)",
  "license": "MIT",
  "author": {
    "name": "University of Basel",
    "url": "https://rise.unibas.ch/en/"
  },
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "bin": {
    "odeuropa-eokg-mcp": "src/index.js"
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "start": "node src/index.js",
    "serve": "node src/http.js",
    "test": "node --test \"test/*.test.js\"",
    "test:live": "EOKG_LIVE=1 node --test \"test/*.test.js\"",
    "build:docs": "node scripts/build-docs.mjs",
    "build:skill": "node scripts/build-skill.mjs",
    "build:viewer": "node scripts/build-viewer.mjs",
    "dev:viewer": "vite dev -c apps/image-viewer/vite.config.mjs",
    "build:iconclass": "node scripts/build-iconclass.mjs",
    "lint": "eslint .",
    "inspector": "npx @modelcontextprotocol/inspector node src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "eslint": "10.6.0",
    "globals": "17.13.0",
    "railway": "^3.16.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
